# Streamlit Cloud secrets template.
#
# Cloud: paste these into your app's Settings → Secrets.
# Local: copy to .streamlit/secrets.toml (gitignored), or use a .env file.

# ============================================================
# Multi-user authentication (recommended for any shared deploy)
# ============================================================
# Add one entry per allowed user. The username becomes their data-isolation
# key — uploaded documents, conversation history, and agent runs are stored
# under .data/<username>/... and logs/<username>/... so different users
# never see each other's data.
#
# If this whole [users] block is missing, the app runs in single-tenant
# '_local' mode (suitable for local dev only).

[users]
# alice = "alice-secret"
# bob   = "bob-secret"

# ============================================================
# LLM provider keys
# ============================================================
HF_TOKEN = "hf_xxx"
OPENAI_API_KEY = "sk-xxx"
# ANTHROPIC_API_KEY = "sk-ant-xxx"
# FIREWORKS_API_KEY = "fw_xxx"
# DASHSCOPE_API_KEY = "sk-xxx"

# ============================================================
# Optional endpoint override
# ============================================================
# OPENAI_BASE_URL = "https://api.openai.com/v1"

# ============================================================
# Optional web-search providers (DuckDuckGo needs no key)
# ============================================================
# TAVILY_API_KEY = "tvly-xxx"
# BRAVE_API_KEY  = "xxx"

# ============================================================
# Persistent logging (Supabase Postgres) — STRONGLY recommended for Cloud
# ============================================================
# Without these, all chat / agent / event logs live only on Streamlit Cloud's
# ephemeral filesystem and disappear on every redeploy or container restart.
# With these, every turn / agent run / event is also INSERTed into Supabase
# Postgres and survives restarts.
#
# Setup (5 min, free tier 500 MB):
#   1) https://supabase.com/dashboard  → New project (any name, any region)
#   2) Project Settings → API → copy "Project URL" and "anon public" key
#   3) SQL Editor → paste the contents of db_schema.sql → Run
#   4) Fill in below and Save. Reboot the app from Manage app.
#
# SUPABASE_URL = "https://xxxxxxxxxxxxxxxx.supabase.co"
# SUPABASE_KEY = "eyJhbGciOiJI...your-anon-public-key..."
