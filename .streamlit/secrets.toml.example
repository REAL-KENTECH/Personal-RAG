# Streamlit Cloud secrets template.
#
# Streamlit Cloud usage: open your app's Settings → Secrets and paste the
# entries you need (the file at .streamlit/secrets.toml is gitignored).
#
# Local usage: either copy this to .streamlit/secrets.toml, OR use a
# .env file at the project root. The app reads both.

# --- LLM provider keys (only the one you use) ---
HF_TOKEN = "hf_xxx"
OPENAI_API_KEY = "sk-xxx"
# DASHSCOPE_API_KEY = "sk-xxx"

# --- Optional endpoint override (rare; presets cover most cases) ---
# OPENAI_BASE_URL = "https://api.openai.com/v1"

# --- Optional web-search providers (DuckDuckGo needs no key) ---
# TAVILY_API_KEY = "tvly-xxx"
# BRAVE_API_KEY = "xxx"
